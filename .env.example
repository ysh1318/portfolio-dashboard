# Firebase config for the DASHBOARD app.
# Same Firebase project as the public site (see spec §4.1) — get these
# values from Firebase Console > Project Settings > General > Your apps.
# You can reuse the SAME web app config as the public site, or register
# a second "Web app" in the same Firebase project for the dashboard —
# either works, since it's the project (Firestore + Auth) that matters,
# not which registered app the config came from.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
